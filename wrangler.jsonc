// Deploys index.html as the "ballotship" Worker (static assets only, no server code).
// Deploy with: npx wrangler deploy --message "build N"
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ballotship",
  "account_id": "907c63834a38c160f1294cfc347a059a",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "."
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "ballotship.electionadminsuite.com", "custom_domain": true },
    // Needed: *.electionadminsuite.com/* is routed to poll-worker-system, and this
    // more specific route is what sends ballotship traffic here instead.
    { "pattern": "ballotship.electionadminsuite.com/*", "zone_name": "electionadminsuite.com" }
  ]
}
