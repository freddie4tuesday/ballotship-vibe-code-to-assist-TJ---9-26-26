// The LIVE inject library: where the injects are listed, edited and reordered, and where the game
// fetches its deck. Its own Worker and store, so an edit never touches the game's code.
// Deploy with ../deploy.sh. The editor is at /edit and needs an emailed sign-in link (build 15; see src/index.js).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ballotship-injects",
  "account_id": "907c63834a38c160f1294cfc347a059a",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  // Who may sign in to the editor, and the address the sign-in emails come from (a Resend-verified address).
  // RESEND_API_KEY is a secret set with `wrangler secret put`, not here.
  "vars": { "ALLOWED_DOMAINS": "readyfortuesday.com,decaro.net", "MAIL_FROM": "Ballotship <ballotship-no-reply@electionadminsuite.com>" },
  "assets": { "directory": "site", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "DECK", "class_name": "Deck" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Deck"] }],
  "routes": [
    { "pattern": "ballotship-injects.electionadminsuite.com", "custom_domain": true },
    // Needed for the same reason as the game's route: *.electionadminsuite.com/* goes to poll-worker-system.
    { "pattern": "ballotship-injects.electionadminsuite.com/*", "zone_name": "electionadminsuite.com" }
  ]
}
