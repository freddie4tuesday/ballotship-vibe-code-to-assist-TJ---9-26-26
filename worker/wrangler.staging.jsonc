// The STAGING relay: same code as the live relay, its own Worker and its own rooms, so a
// relay change can be tried for real before any live game depends on it.
// Deploy with ../deploy.sh staging.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ballotship-relay-staging",
  "account_id": "907c63834a38c160f1294cfc347a059a",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [
    { "pattern": "ballotship-relay-staging.electionadminsuite.com", "custom_domain": true },
    // Needed for the same reason as the page's route above.
    { "pattern": "ballotship-relay-staging.electionadminsuite.com/*", "zone_name": "electionadminsuite.com" }
  ]
}
